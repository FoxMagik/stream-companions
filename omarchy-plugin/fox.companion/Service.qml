  function currentMeta() {
    for (var i = 0; i < root.speciesList.length; i++) {
      if (root.speciesList[i].id === root.currentSpecies) return root.speciesList[i]
    }
    return root.speciesList[0]
  }

  function activePalette() {
    return root.speciesPalettes[root.currentSpecies] || root.speciesPalettes["fox"]
  }

  function activeGeom() {
    var m = root.currentMeta()
    return root.geometries[m.geom] || root.geometries["fox"]
  }

