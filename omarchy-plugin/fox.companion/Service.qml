        property var currentButterflySprite: root.butterfly1
        property int currentButterflyFrame: 1

        // Bouncy Toy Ball State
        property bool ballVisible: false
        property real ballX: 300
        property real ballY: 300
        property real ballVx: 4.5
        property real ballVy: 0
        property real ballFloorY: 400
        property int ballBoopsLeft: 4
        property var currentBallSprite: root.ball1
        property int currentBallFrame: 1

        // Visiting Bear Friend properties
        property string bearState: "hidden"
        property real bearX: -110
        property real bearY: Math.max(200, window.height - root.foxH - 24)
        property real bearExitX: -110
        property bool bearFacingRight: true
        property int bearTimer: 420
        property var currentBearSprite: root.bearWalk1
        property string currentBearPoseName: "walk1"
        property string bearBubbleText: ""

        Connections {
          target: root
          function onSummonBearSignalChanged() {
            window.startBearVisit()
          }
          function onActivitySignalChanged() {
            if (root.requestedActivity === "dance") window.startDance()
            else if (root.requestedActivity === "ball") window.startBallPlay()
            else if (root.requestedActivity === "butterfly") window.startButterflyChase()
          }
          function onToggleSelectorSignalChanged() {
            window.selectorOpen = !window.selectorOpen
          }
          function onCurrentSpeciesChanged() {
            var m = root.currentMeta()
            window.showBubble(m.icon + " " + m.name + "!")
            foxCanvas.requestPaint()
          }
        }

        function cycleSpecies(dir) {
          var list = root.speciesList
          var idx = 0
          for (var i = 0; i < list.length; i++) {
            if (list[i].id === root.currentSpecies) {
              idx = i
              break
            }
          }
          var nextIdx = (idx + dir + list.length) % list.length
          root.currentSpecies = list[nextIdx].id
        }

        function startDance() {
          window.butterflyVisible = false
          window.ballVisible = false
          window.mode = "dance"
          window.modeTimer = 210 + Math.floor(Math.random() * 60)
          window.showBubble("♪ ♫ *boogie* ♫ ♪")
        }

        function startButterflyChase() {
          window.ballVisible = false
          window.mode = "butterfly"
          window.modeTimer = 360 + Math.floor(Math.random() * 120)
          window.butterflyVisible = true
          var goRight = window.foxX < window.width * 0.5
          window.butterflyX = Math.max(60, Math.min(window.width - 80, window.foxX + (goRight ? 140 : -140)))
          window.butterflyBaseY = Math.max(90, window.foxY + 10)
          window.butterflyY = window.butterflyBaseY
          window.butterflyVx = goRight ? 2.1 : -2.1
          window.butterflyPhase = 0
          window.showBubble("🦋 Oooh!")
        }

        function startBallPlay() {
          window.butterflyVisible = false
          window.mode = "ball"
          window.modeTimer = 420 + Math.floor(Math.random() * 120)
          window.ballVisible = true
          var dir = window.foxX < window.width * 0.5 ? 1 : -1
          window.ballX = window.foxX + root.foxW * 0.5 + dir * 90
          window.ballFloorY = Math.min(Math.max(160, window.height - 30), window.foxY + Math.round(154 * root.spriteScale) - 30)
          window.ballY = window.foxY - 50
          window.ballVx = dir * 3.8
          window.ballVy = -4.0
          window.ballBoopsLeft = 6
          window.showBubble("⚽ Playtime!")
        }

        function pickNextActivity() {
          // calm-weighted: ~60% rest / sit / watch / nap, the rest play
          var r = Math.random()
          if (r < 0.20) {
            window.mode = "rest"                       // stand and look around
            window.modeTimer = 90 + Math.floor(Math.random() * 90)
          } else if (r < 0.34) {
            window.mode = "walk"
            window.modeTimer = 450
            window.pickDestination()
          } else if (r < 0.50) {
            window.mode = "sit"
            window.modeTimer = 300 + Math.floor(Math.random() * 240)
          } else if (r < 0.62) {
            window.startButterflyWatch()
          } else if (r < 0.73) {
            window.startButterflyChase()
          } else if (r < 0.84) {
            window.startBallPlay()
          } else if (r < 0.91) {
            window.startDance()
          } else {
            window.butterflyVisible = false
            window.ballVisible = false
            window.mode = "sleep"
            window.modeTimer = 750 + Math.floor(Math.random() * 450)
            window.showBubble("Zzz...")
          }
        }

        function startButterflyWatch() {
          // sit and watch the butterfly loop lazily around, then drift away
          window.ballVisible = false
          window.butterflyVisible = true
          window.mode = "watch"
          window.modeTimer = 300 + Math.floor(Math.random() * 150)
          window.butterflyPhase = 0
          window.showBubble("🦋 ...")
        }

        function startBearVisit() {
          return // bear friend retired for now
          if (window.bearState !== "hidden") return
          var fromLeft = window.foxX > window.width * 0.5
          window.bearX = fromLeft ? -104 : window.width + 10
          window.bearExitX = fromLeft ? -110 : window.width + 20
          window.bearY = window.foxY
          window.bearFacingRight = fromLeft
          window.bearState = "enter"
          window.bearTimer = 300
        }

        function pickDestination() {
          var maxW = Math.max(140, window.width - root.foxW - 14)
          var maxH = Math.max(140, window.height - root.foxH - 18)
          window.targetX = 24 + Math.random() * (maxW - 24)
          if (Math.random() < 0.45) {
            window.targetY = maxH
          } else {
            window.targetY = 48 + Math.random() * (maxH - 48)
          }
        }

        function showBubble(msg) {
          window.bubbleText = msg
          bubbleHideTimer.restart()
        }

        function showBearBubble(msg) {
          window.bearBubbleText = msg
          bearBubbleHideTimer.restart()
        }

        Timer {
          id: bubbleHideTimer
          interval: 1600
          onTriggered: window.bubbleText = ""
        }

        Timer {
          id: bearBubbleHideTimer
          interval: 1900
          onTriggered: window.bearBubbleText = ""
        }

        Timer {
          id: foxReplyTimer
          interval: 700
          onTriggered: {
            var replies = window.mode === "sleep"
              ? ["💤 *sleepy wag*", "♥ zZz... hi Bear!"]
              : ["♥ Hi Bear!", "★ Yip yip!", "♪ Let's dance!", "🍯 Yay!"]
            window.showBubble(replies[Math.floor(Math.random() * replies.length)])
          }
        }

        Timer {
          id: animTimer
          interval: 33
          running: window.shown
          repeat: true
          onTriggered: {
            window.frameTick++
            var geom = root.activeGeom()
            if (dragArea.drag.active) {
              window.foxX = foxActor.x
              window.foxY = foxActor.y
              window.currentPoseName = "jump1"
              window.currentSprite = geom["jump1"]
              window.spriteAnim = "stand_hop"
              window.spriteFrame = 3
              if (!root.use3D) foxCanvas.requestPaint()
              return
            }

            window.modeTimer--

            if (window.jumpY < 0 || window.jumpVy < 0) {
              window.jumpY += window.jumpVy
              window.jumpVy += 1.1
              if (window.jumpY >= 0) {
                window.jumpY = 0
                window.jumpVy = 0
                if (window.mode === "jump") window.mode = "walk"
              }
            }

            if (window.bearState === "greet" && window.mode !== "sleep") {
              window.facingRight = window.bearX > window.foxX
            } else if (window.mode === "butterfly") {
              window.butterflyPhase++
              window.butterflyX += window.butterflyVx
              if (window.butterflyX < 40 || window.butterflyX > window.width - 70) {
                window.butterflyVx = -window.butterflyVx
              }
              if (window.modeTimer < 45) {
                window.butterflyBaseY -= 2.4
              }
              window.butterflyY = window.butterflyBaseY + Math.sin(window.butterflyPhase * 0.18) * 18

              var bfTargetX = window.butterflyX + 16 - root.foxW * 0.5
              var bfTargetY = Math.min(window.height - root.foxH - 18, window.butterflyBaseY - 10)
              var bfx = bfTargetX - window.foxX
              var bfy = bfTargetY - window.foxY
              var bfDist = Math.sqrt(bfx * bfx + bfy * bfy)
              if (bfDist > 6) {
                window.foxX += (bfx / bfDist) * 2.9
                window.foxY += (bfy / bfDist) * 1.8
                if (Math.abs(bfx) > 0.2) window.facingRight = bfx > 0
              }
              if (bfDist < 34 && window.jumpY === 0 && window.modeTimer > 45 && window.frameTick % 28 === 0) {
                window.jumpVy = -8.8
                var bfQuips = ["🦋 Boop!", "✨ Flutter!", "★ Almost!", "♥ Wheee!"]
                window.showBubble(bfQuips[Math.floor(Math.random() * bfQuips.length)])
              }

              var bfF = Math.floor(window.frameTick / 3) % 2 === 0 ? 1 : 2
              window.currentButterflyFrame = bfF
              window.currentButterflySprite = bfF === 1 ? root.butterfly1 : root.butterfly2
              butterflyActor.x = Math.round(window.butterflyX)
              butterflyActor.y = Math.round(window.butterflyY)
              if (!root.use3D) butterflyCanvas.requestPaint()

              if (window.modeTimer <= 0 || window.butterflyY < -40) {
                window.butterflyVisible = false
                window.mode = "sit"
                window.modeTimer = 180 + Math.floor(Math.random() * 120)
              }
            } else if (window.mode === "ball") {
              window.ballX += window.ballVx
              window.ballY += window.ballVy
              window.ballVy += 0.65

              if (window.ballY >= window.ballFloorY) {
                window.ballY = window.ballFloorY
                window.ballVy = -Math.abs(window.ballVy) * 0.74
                window.ballVx *= 0.94
                if (Math.abs(window.ballVy) < 1.5) window.ballVy = 0
              }
              if (window.ballX < 24) {
                window.ballX = 24
                window.ballVx = Math.abs(window.ballVx)
              } else if (window.ballX > window.width - 54) {
                window.ballX = window.width - 54
                window.ballVx = -Math.abs(window.ballVx)
              }

              var ballRight = (window.ballX + 14) > (window.foxX + root.foxW * 0.5)
              var bx = (window.ballX + 14 - root.foxW * (ballRight ? 0.84 : 0.16)) - window.foxX
              var by = (window.ballFloorY + 30 - Math.round(154 * root.spriteScale)) - window.foxY
              var bDist = Math.sqrt(bx * bx + by * by)
              if (bDist > 6) {
                window.foxX += (bx / bDist) * 3.1
                window.foxY += (by / bDist) * 1.8
                if (Math.abs(bx) > 0.2) window.facingRight = bx > 0
              }

              var noseX = window.facingRight ? window.foxX + root.foxW * 0.88 : window.foxX + root.foxW * 0.12
              var noseY = window.foxY + root.foxH * 0.72
              var hitDist = Math.sqrt(Math.pow(window.ballX + 14 - noseX, 2) + Math.pow(window.ballY + 14 - noseY, 2))
              if (hitDist < 40 && window.ballBoopsLeft > 0) {
                window.ballBoopsLeft--
                var kickDir = window.foxX < window.width * 0.25 ? 1 : (window.foxX > window.width * 0.75 ? -1 : (window.facingRight ? 1 : -1))
                window.ballVx = kickDir * (4.2 + Math.random() * 2.5)
                window.ballVy = -8.5 - Math.random() * 2.5
                window.jumpVy = -5.5
                var ballQuips = ["⚽ Boop!", "★ Dribble!", "♥ Goal!", "⚡ Bounce!"]
                window.showBubble(ballQuips[Math.floor(Math.random() * ballQuips.length)])
              }

              var blF = Math.floor(window.frameTick / 4) % 2 === 0 ? 1 : 2
              window.currentBallFrame = blF
              window.currentBallSprite = blF === 1 ? root.ball1 : root.ball2
              ballActor.x = Math.round(window.ballX)
              ballActor.y = Math.round(window.ballY)
              if (!root.use3D) ballCanvas.requestPaint()

              if (window.modeTimer <= 0 || (window.ballBoopsLeft <= 0 && Math.abs(window.ballVx) < 0.8)) {
                window.ballVisible = false
                window.mode = "sit"
                window.modeTimer = 180 + Math.floor(Math.random() * 120)
              }
            } else if (window.mode === "dance") {
              if (window.frameTick % 10 === 0 && window.jumpY === 0) {
                window.jumpVy = -4.2
              }
              if (window.frameTick % 20 === 0) {
                window.facingRight = !window.facingRight
              }
              if (window.frameTick % 45 === 0) {
                var notes = ["♪ ♫ *boogie* ♫ ♪", "💃 Happy dance!", "★ Groove! ♪", "♫ Cha-cha! ♪"]
                window.showBubble(notes[Math.floor(Math.random() * notes.length)])
              }
              if (window.modeTimer <= 0) {
                window.mode = "walk"
                window.modeTimer = 150
                window.pickDestination()
              }
            } else if (window.mode === "walk" || window.mode === "jump") {
              var dx = window.targetX - window.foxX
              var dy = window.targetY - window.foxY
              var dist = Math.sqrt(dx * dx + dy * dy)
              if (dist < 8 || window.modeTimer <= 0) {
                window.pickNextActivity()
              } else {
                var speed = window.mode === "jump" ? 4.2 : 2.1
                var vx = (dx / dist) * speed
                var vy = (dy / dist) * (speed * 0.65)
                window.foxX += vx
                window.foxY += vy
                if (Math.abs(vx) > 0.1) window.facingRight = vx > 0
              }
            } else if (window.mode === "sit") {
              if (window.modeTimer <= 0) window.pickNextActivity()
            } else if (window.mode === "watch") {
              window.butterflyPhase++
              var wt = window.butterflyPhase * 0.04
              window.butterflyX = window.foxX + root.foxW * 0.5 - 16 + Math.sin(wt) * root.foxW * 0.75
              window.butterflyY = window.foxY + root.foxH * 0.12 + Math.sin(wt * 2) * root.foxH * 0.12 - (window.modeTimer < 45 ? (45 - window.modeTimer) * 5 : 0)
              var wrel = window.butterflyX + 16 - (window.foxX + root.foxW * 0.5)
              if (Math.abs(wrel) > 12) window.facingRight = wrel > 0   // follow it with the head
              var wbF = Math.floor(window.frameTick / 3) % 2 === 0 ? 1 : 2
              window.currentButterflyFrame = wbF
              window.currentButterflySprite = wbF === 1 ? root.butterfly1 : root.butterfly2
              butterflyActor.x = Math.round(window.butterflyX)
              butterflyActor.y = Math.round(window.butterflyY)
              if (!root.use3D) butterflyCanvas.requestPaint()
              if (window.frameTick % 150 === 0) {
                var looks = ["🦋 ...", "✨ Pretty...", "♥ Hehe"]
                window.showBubble(looks[Math.floor(Math.random() * looks.length)])
              }
              if (window.modeTimer <= 0) {
                window.butterflyVisible = false
                window.mode = "sit"
                window.modeTimer = 180 + Math.floor(Math.random() * 120)
              }
            } else if (window.mode === "rest") {
              if (window.modeTimer <= 0) window.pickNextActivity()
            } else if (window.mode === "sleep") {
              if (window.frameTick % 60 === 0) window.showBubble("zZz...")
              if (window.modeTimer <= 0) {
                window.mode = "walk"
                window.modeTimer = 160
                window.pickDestination()
              }
            }

            var nextPose = "sit1"
            if (window.jumpY < -1 && window.mode !== "dance") {
              nextPose = "jump1"
            } else if (window.mode === "dance") {
              var dc = Math.floor(window.frameTick / 6) % 2 === 0
              nextPose = dc ? "dance1" : "dance2"
            } else if (window.mode === "walk" || window.mode === "butterfly" || window.mode === "ball") {
              var c = Math.floor(window.frameTick / 4) % 4
              nextPose = ["walk1", "walk2", "walk3", "walk2"][c]
            } else if (window.mode === "sit" || window.mode === "watch" || window.mode === "rest") {
              var wag = Math.floor(window.frameTick / 12) % 2 === 0
              nextPose = wag ? "sit1" : "sit2"
            } else if (window.mode === "sleep") {
              var breathe = Math.floor(window.frameTick / 32) % 2 === 0
              nextPose = breathe ? "sleep1" : "sleep2"
            }

            window.currentPoseName = nextPose
            window.currentSprite = geom[nextPose]

            // Pixel Fox sprite-sheet animation (Sprite style)
            var airborne = window.jumpY < -1 && window.mode !== "dance"
            var anim = ""
            var sf = -1
            if (window.foxEmote !== "" && window.frameTick < window.foxEmoteUntil) {
              anim = window.foxEmote
            } else if (airborne) {
              anim = "stand_hop"   // hop frame follows the real jump velocity: rise, apex, fall
              sf = window.jumpVy < -5 ? 1 : (window.jumpVy < -1.5 ? 2 : (window.jumpVy < 1.5 ? 3 : (window.jumpVy < 4 ? 4 : 5)))
            } else {
              var modeAnim = { walk: "walk4", jump: "walk4", butterfly: "trot", ball: "trot", dance: "happy", sit: "idle", sleep: "sleep", watch: "sit_side", rest: "stand_idle" }
              anim = modeAnim[window.mode] || "stand_idle"
            }
            if (sf < 0) sf = Math.floor(window.frameTick * root.spriteAnims[anim].fps / 30) % root.spriteAnims[anim].frames
            window.spriteAnim = anim
            window.spriteFrame = sf
            foxActor.x = Math.round(window.foxX)
            foxActor.y = Math.round(window.foxY + window.jumpY)
            if (!root.use3D) foxCanvas.requestPaint()

            // Step Visiting Bear Friend
            if (window.bearState === "hidden") {
              window.bearTimer--
              if (window.bearTimer <= 0) {
                window.startBearVisit()
              }
            } else {
              var spacing = 78
              var desiredX = window.bearX < window.foxX
                ? Math.max(16, window.foxX - spacing)
                : Math.min(window.width - 110, window.foxX + spacing)
              var desiredY = window.foxY

              if (window.bearState === "enter") {
                var bdx = desiredX - window.bearX
                var bdy = desiredY - window.bearY
                var bdist = Math.sqrt(bdx * bdx + bdy * bdy)
                if (bdist <= 8) {
                  window.bearState = "greet"
                  window.bearTimer = 160
                  window.bearFacingRight = window.foxX > window.bearX
                  var greets = ["👋 Hewwo friend!", "🍯 Brought honey!", "♥ Hiya buddy!", "✨ Rawr! Hi!"]
                  window.showBearBubble(greets[Math.floor(Math.random() * greets.length)])
                  window.facingRight = window.bearX > window.foxX
                  if (window.mode !== "sleep") {
                    if (Math.random() < 0.45) {
                      window.startDance()
                    } else {
                      window.mode = "sit"
                      window.jumpVy = -6.0
                    }
                  }
                  foxReplyTimer.restart()
                } else {
                  window.bearX += (bdx / bdist) * 2.2
                  window.bearY += (bdy / bdist) * 1.6
                  window.bearFacingRight = bdx > 0
                }
              } else if (window.bearState === "greet") {
                window.bearFacingRight = window.foxX > window.bearX
                if (window.mode === "sit") window.facingRight = window.bearX > window.foxX
                window.bearTimer--
                if (window.bearTimer <= 0) {
                  window.bearState = "leave"
                  var byes = ["👋 Bye-bye!", "🐾 See ya soon!", "🍯 Off I trot!"]
                  window.showBearBubble(byes[Math.floor(Math.random() * byes.length)])
                }
              } else if (window.bearState === "leave") {
                var exDx = window.bearExitX - window.bearX
                if (Math.abs(exDx) <= 10) {
                  window.bearState = "hidden"
                  window.bearTimer = 1200 + Math.floor(Math.random() * 900)
                } else {
                  window.bearX += (exDx > 0 ? 1 : -1) * 2.2
                  window.bearFacingRight = exDx > 0
                }
              }

              var nextBear = root.bearWalk1
              var nextBearPose = "walk1"
              if (window.bearState === "greet") {
                var wv = Math.floor(window.frameTick / 10) % 2 === 0
                nextBear = wv ? root.bearWave1 : root.bearWave2
                nextBearPose = wv ? "bearWave1" : "bearWave2"
              } else {
                var bc = Math.floor(window.frameTick / 4) % 4
                nextBear = [root.bearWalk1, root.bearWalk2, root.bearWalk3, root.bearWalk2][bc]
                nextBearPose = ["walk1", "walk2", "walk3", "walk2"][bc]
              }
              window.currentBearPoseName = nextBearPose
              window.currentBearSprite = nextBear
              bearActor.x = Math.round(window.bearX)
              bearActor.y = Math.round(window.bearY)
              if (!root.use3D) bearCanvas.requestPaint()
            }
          }
        }

        // Dynamic input mask covering the pet + selector menu when open
        Item {
          id: interactiveMask
          x: foxActor.x
          y: window.selectorOpen ? Math.max(8, foxActor.y - 70) : foxActor.y
          width: Math.max(foxActor.width, 186)
          height: window.selectorOpen ? foxActor.height + 72 : foxActor.height
        }

        // Fluttering Butterfly Actor
        Item {
          id: butterflyActor
          visible: window.butterflyVisible
          x: 300
          y: 300
          width: 32
          height: 28

          Image {
            anchors.fill: parent
            visible: root.use3D
            smooth: true
            mipmap: true
            source: Qt.resolvedUrl("sprites3d/butterfly" + window.currentButterflyFrame + ".png")
          }

          Canvas {
            id: butterflyCanvas
            anchors.fill: parent
            visible: !root.use3D
            smooth: false
            onPaint: {
              var ctx = getContext("2d")
              ctx.clearRect(0, 0, width, height)
              var grid = window.currentButterflySprite
              if (!grid) return
              var pal = root.speciesPalettes["fox"]
              for (var r = 0; r < grid.length; r++) {
                var row = grid[r]
                for (var c = 0; c < row.length; c++) {
                  var ch = row.charAt(c)
                  if (ch === ".") continue
                  var col = pal[ch]
                  if (!col) continue
                  ctx.fillStyle = col
                  ctx.fillRect(c * 2, r * 2, 2, 2)
                }
              }
            }
          }
        }

        // Bouncy Toy Ball Actor
        Item {
          id: ballActor
          visible: window.ballVisible
          x: 300
          y: 300
          width: 28
          height: 28

          Image {
            anchors.fill: parent
            visible: root.use3D
            smooth: true
            mipmap: true
            source: Qt.resolvedUrl("sprites3d/ball" + window.currentBallFrame + ".png")
          }

          Canvas {
            id: ballCanvas
            anchors.fill: parent
            visible: !root.use3D
            smooth: false
            onPaint: {
              var ctx = getContext("2d")
              ctx.clearRect(0, 0, width, height)
              var grid = window.currentBallSprite
              if (!grid) return
              var pal = root.speciesPalettes["fox"]
              for (var r = 0; r < grid.length; r++) {
                var row = grid[r]
                for (var c = 0; c < row.length; c++) {
                  var ch = row.charAt(c)
                  if (ch === ".") continue
                  var col = pal[ch]
                  if (!col) continue
                  ctx.fillStyle = col
                  ctx.fillRect(c * 2, r * 2, 2, 2)
                }
              }
            }
          }
        }

        // Bear Friend Actor
        Item {
          id: bearActor
          visible: window.bearState !== "hidden"
          x: -110
          y: 400
          width: 96
          height: 72

          Text {
            anchors.horizontalCenter: parent.horizontalCenter
            y: -16
            textFormat: Text.PlainText
            text: window.bearBubbleText
            visible: window.bearBubbleText !== ""
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 12
            font.bold: true
            color: "#ffd07b"
            style: Text.Outline
            styleColor: "#1a1423"
          }

          Image {
            anchors.fill: parent
            visible: root.use3D
            smooth: true
            mipmap: true
            source: window.bearState !== "hidden" ? Qt.resolvedUrl("sprites3d/bear_" + window.currentBearPoseName + ".png") : ""   // bear retired; no image loaded
            transform: Scale {
              origin.x: bearActor.width / 2
              xScale: window.bearFacingRight ? 1 : -1
            }
          }

          Canvas {
            id: bearCanvas
            anchors.fill: parent
            visible: !root.use3D
            smooth: false
            onPaint: {
              var ctx = getContext("2d")
              ctx.clearRect(0, 0, width, height)
              var grid = window.currentBearSprite
              if (!grid) return
              var flipX = !window.bearFacingRight
              for (var r = 0; r < grid.length; r++) {
                var row = grid[r]
                for (var c = 0; c < row.length; c++) {
                  var ch = row.charAt(c)
                  if (ch === ".") continue
                  var col = root.bearPalette[ch]
                  if (!col) continue
                  var drawX = flipX ? (47 - c) * 2 : c * 2
                  ctx.fillStyle = col
                  ctx.fillRect(drawX, r * 2, 2, 2)
                }
              }
            }
          }
        }

        // Main Companion Actor
        Item {
          id: foxActor
          x: 220
          y: 400
          width: root.foxW
          height: root.foxH

          Text {
            anchors.horizontalCenter: parent.horizontalCenter
            y: -16
            textFormat: Text.PlainText
            text: window.bubbleText
            visible: window.bubbleText !== "" && !window.selectorOpen
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 12
            font.bold: true
            color: root.currentMeta().bubbleColor
            style: Text.Outline
            styleColor: "#1a1423"
          }

          Image {
            width: 96
            height: 72
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            visible: root.foxStyle === "3d"
            smooth: true
            mipmap: true
            source: Qt.resolvedUrl("sprites3d/fox_" + window.currentPoseName + ".png")
            transform: Scale {
              origin.x: 48
              xScale: window.facingRight ? 1 : -1
            }
          }

          Canvas {
            id: foxCanvas
            width: 96
            height: 72
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            visible: root.foxStyle === "pixel"
            smooth: false
            onPaint: {
              var ctx = getContext("2d")
              ctx.clearRect(0, 0, width, height)
              var grid = window.currentSprite
              if (!grid) return
              var pal = root.activePalette()
              var flipX = !window.facingRight
              for (var r = 0; r < grid.length; r++) {
                var row = grid[r]
                for (var c = 0; c < row.length; c++) {
                  var ch = row.charAt(c)
                  if (ch === ".") continue
                  var col = pal[ch]
                  if (!col) continue
                  var drawX = flipX ? (47 - c) * 2 : c * 2
                  ctx.fillStyle = col
                  ctx.fillRect(drawX, r * 2, 2, 2)
                }
              }
            }
          }

          // Pixel Fox: a clipped window onto the sprite sheet, moved to the current frame
          Item {
            id: spriteView
            anchors.fill: parent
            visible: root.foxStyle === "sprite"
            clip: true
            transform: Scale {
              origin.x: spriteView.width / 2
              xScale: (window.spriteInfo.side && window.facingRight) ? -1 : 1
            }
            Image {
              source: Qt.resolvedUrl("fox-sprites.png")
              smooth: false
              x: -window.spriteFrame * root.cellW * root.spriteScale
              y: -window.spriteInfo.row * root.cellH * root.spriteScale
              width: sourceSize.width * root.spriteScale
              height: sourceSize.height * root.spriteScale
            }
          }

          MouseArea {
            id: dragArea
            anchors.fill: parent
            hoverEnabled: true
            acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
            drag.target: foxActor
            cursorShape: Qt.PointingHandCursor
            onWheel: function(wheel) {
              // species switching retired for now (fox only)
            }
            onClicked: function(mouse) {
              if (mouse.button === Qt.MiddleButton) {
                window.startBearVisit()
              } else if (mouse.button === Qt.RightButton) {
                if (mouse.modifiers & Qt.ShiftModifier) {
                  window.selectorOpen = !window.selectorOpen
                } else if (window.mode === "sleep") {
                  window.mode = "walk"
                  window.modeTimer = 180
                  window.pickDestination()
                  window.showBubble("! Awake!")
                  window.foxEmote = "surprised"
                  window.foxEmoteUntil = window.frameTick + 24
                } else {
                  window.butterflyVisible = false
                  window.ballVisible = false
                  window.mode = "sleep"
                  window.modeTimer = 900
                  window.showBubble("Zzz...")
                }
              } else {
                if (mouse.modifiers & Qt.ShiftModifier) {
                  window.selectorOpen = !window.selectorOpen
                  return
                }
                window.clickCycle = (window.clickCycle + 1) % 4
                if (window.clickCycle === 1) {
                  window.startButterflyChase()
                } else if (window.clickCycle === 2) {
                  window.startBallPlay()
                } else if (window.clickCycle === 3) {
                  window.startDance()
                } else {
                  window.butterflyVisible = false
                  window.ballVisible = false
                  window.mode = "jump"
                  window.jumpVy = -9.5
                  window.modeTimer = 160
                  window.pickDestination()
                  var sp = root.currentSpecies
                  var pounceMsg = sp === "chillet" ? "❄️ *noodle boing!*" : (sp.indexOf("cat") !== -1 ? "🐾 *pounce!*" : "★ Boing!")
                  window.showBubble(pounceMsg)
                }
              }
            }
          }

          // Small '[🐾]' Companion Selector Badge in top-right corner on hover
          Rectangle {
            id: selectorBadge
            x: foxActor.width - 30
            y: 8
            width: 22
            height: 20
            radius: 6
            color: "#1e182b"
            border.color: "#ff9e44"
            border.width: 1
            opacity: (dragArea.containsMouse || badgeArea.containsMouse || window.selectorOpen) ? 0.95 : 0.0
            Behavior on opacity { NumberAnimation { duration: 150 } }

            Text {
              anchors.centerIn: parent
              text: "🐾"
              font.pixelSize: 11
            }

            MouseArea {
              id: badgeArea
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: window.selectorOpen = !window.selectorOpen
            }
          }
        }

        // Floating Companion Selector Popup
        Rectangle {
          id: selectorPopup
          visible: window.selectorOpen
          x: foxActor.x
          y: Math.max(8, foxActor.y - 66)
          width: 180
          height: 61
          radius: 10
          color: "#191424"
          border.color: "#ff9e44"
          border.width: 1.5
          opacity: 0.96

          Column {
            anchors.fill: parent
            anchors.margins: 6
            spacing: 2

            // 3D Plushie vs 16-Bit Pixel Toggle Button
            Rectangle {
              width: 168
              height: 24
              radius: 6
              color: styleMouse.containsMouse ? "#3b2c59" : "#2b2042"
              border.color: root.use3D ? "#73c7ff" : "#ff9e44"
              border.width: 1

              Text {
                anchors.centerIn: parent
                text: root.foxStyleName()
                font.family: "JetBrainsMono Nerd Font"
                font.pixelSize: 10
                font.bold: true
                color: root.use3D ? "#9ee0ff" : "#ffd07b"
              }

              MouseArea {
                id: styleMouse
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: {
                  root.cycleFoxStyle()
                  foxCanvas.requestPaint()
                }
              }
            }

            Repeater {
              model: [root.speciesList[0]]   // fox only for now
              delegate: Rectangle {
                required property var modelData
                width: 168
                height: 23
                radius: 6
                color: root.currentSpecies === modelData.id ? "#35284d" : (itemMouse.containsMouse ? "#261d38" : "transparent")
                border.color: root.currentSpecies === modelData.id ? modelData.bubbleColor : "transparent"
                border.width: 1

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  x: 8
                  text: modelData.icon + "  " + modelData.name
                  font.family: "JetBrainsMono Nerd Font"
                  font.pixelSize: 11
                  font.bold: root.currentSpecies === modelData.id
                  color: root.currentSpecies === modelData.id ? modelData.bubbleColor : "#f0e8ff"
                }

                MouseArea {
                  id: itemMouse
                  anchors.fill: parent
                  hoverEnabled: true
                  cursorShape: Qt.PointingHandCursor
                  onClicked: {
                    root.currentSpecies = modelData.id
                    window.selectorOpen = false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
